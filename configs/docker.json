{
  "version": 1,
  "public": {"address": ":8080", "read_timeout": "10s", "write_timeout": "30s", "idle_timeout": "60s"},
  "admin": {"address": ":9090", "read_timeout": "5s", "write_timeout": "10s", "idle_timeout": "30s", "api_key": "${GATEFORGE_ADMIN_API_KEY}"},
  "runtime": {"shutdown_timeout": "10s", "trusted_proxies": ["172.16.0.0/12"]},
  "storage": {"driver": "postgres", "dsn": "${GATEFORGE_DATABASE_DSN}", "max_open_conns": 10, "max_idle_conns": 5},
  "observability": {"service_name": "gateforge", "tracing_enabled": true, "sample_rate": 1},
  "access_log": {"enabled": true, "format": "json"},
  "routes": [{"id":"api","host":"","path_prefix":"/api","upstream_pool":[{"id":"backend-v1","url":"http://backend-v1:8080","weight":90},{"id":"backend-v2","url":"http://backend-v2:8080","weight":10}],"balance":{"strategy":"weighted_round_robin"},"health_check":{"enabled":true,"path":"/health","interval":"5s","timeout":"1s","healthy_threshold":1,"unhealthy_threshold":2},"retry":{"attempts":2,"backoff":"50ms","statuses":[502,503,504],"methods":["GET","HEAD"]},"circuit_breaker":{"failure_threshold":3,"open_timeout":"15s","half_open_requests":1},"max_body_bytes":1048576,"max_concurrent":100,"strip_prefix":false,"upstream_timeout":"10s"}],
  "policies": [{"id":"api-limit","priority":10,"mode":"block","action":"rate_limit","match":{"route_ids":["api"]},"limit":{"requests":100,"window":"1m","burst":20,"key":"ip","idle_ttl":"10m"}}]
}